# Copy this file to .env.local and paste in your Supabase project's values.
# Find them in Supabase: Project Settings → Data API (URL) and API Keys (anon key).
# Leave the file out entirely and the app runs in local demo mode instead.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
